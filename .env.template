# ============================================================
# AgriShrimp Spring Boot API — Local/Server env template
# Copy this file to `.env` locally or your server secret file.
# Commit this template only. Do not commit real secrets.
# ============================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8004

# Public app URLs
APP_SERVER_URL=https://api.agrishrimp.io.vn
APP_WEB_BASE_URL=https://agrishrimp.io.vn
APP_CORS_ALLOWED_ORIGINS=https://agrishrimp.io.vn
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/agri_shrimp_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# JWT
SECURITY_JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
SECURITY_JWT_ISSUER=agri-shrimp
SECURITY_JWT_EXPIRY_SECONDS=86400
SECURITY_JWT_REFRESHABLE_DURATION_SECONDS=604800

# Captcha / social login
APP_TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET
APP_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
ZALO_APP_SECRET=CHANGE_ME_ZALO_SECRET

# Cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER=agrishrimp/products

# payOS
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
PAYOS_RETURN_URL=https://agrishrimp.io.vn/order-success
PAYOS_CANCEL_URL=https://agrishrimp.io.vn/order-cancel

# Shipping / GHN
SHIPPING_PROVIDER=ghn
GHN_API_KEY=CHANGE_ME
GHN_SHOP_ID=CHANGE_ME

# Geocoding / routing
GEOCODING_PROVIDER=trackasia
TRACKASIA_API_KEY=CHANGE_ME
TRACKASIA_AUTOCOMPLETE_URL=https://api.trackasia.vn/api/geocode/autocomplete
ROUTING_PROVIDER=ors
ORS_API_KEY=CHANGE_ME
TRACKASIA_ROUTING_KEY=CHANGE_ME

# Internal services
IMAGE_SEARCH_URL=http://ai-visual-search:5001
AI_BASE_URL=
AI_PREDICT_PATH=/ai/predict-image
AI_PRESCRIPTION_PATH=/ai/generate-prescription

# Mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME@example.com
SPRING_MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=agri-shrimp-storage
AWS_S3_UPLOAD_DIR=webapp

# OCR/Tesseract
OCR_TESSERACT_LANGUAGE=vie
OCR_TESSERACT_DATA_PATH=/usr/share/tesseract-ocr/5/tessdata
OCR_MAX_FILE_SIZE_BYTES=5242880
OCR_MAX_IMAGE_WIDTH=1800

# Upload / location tuning
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB
LOCATION_DEFAULT_RADIUS_KM=15
LOCATION_MAX_CANDIDATES=5
LOCATION_IP_GEO_URL=http://ip-api.com/json
