# Local backend override template
# This file is auto-loaded by Spring Boot because `application.yml` imports `.env.local`.
# Copy to `.env.local` and keep only the overrides you really need for local work.
#
# Common uses:
# 1. SSH tunnel to server DB:
#    ssh -L 3307:127.0.0.1:3306 <user>@<server>
#    keep SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/...
# 2. Direct remote DB:
#    replace SPRING_DATASOURCE_URL / USER / PASSWORD with the remote host values.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8004

# Local frontend/backend URLs
APP_SERVER_URL=http://localhost:8004
APP_WEB_BASE_URL=http://localhost:3004
APP_CORS_ALLOWED_ORIGINS=http://localhost:3004,http://localhost:8004,https://*.mini.123c.vn,https://mini.123c.vn,https://h5.zdn.vn,https://*.zdn.vn
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Real MySQL through SSH tunnel:
# ssh -L 3307:127.0.0.1:3306 <user>@<server>
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/agri_shrimp_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Keep Redis local while developing
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Optional local AI overrides if you run those services on your machine
AI_BASE_URL=http://localhost:8000
IMAGE_SEARCH_URL=http://localhost:5001
