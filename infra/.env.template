# =============================================================
# .env.template — Template cho <repo>/.env
# Chép file này thành .env ở root repo trên VPS và điền giá trị thật
# File này KHÔNG chứa secret thật — an toàn commit git
# =============================================================

# ── MySQL ─────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_DATABASE=agri_shrimp_db

# ── JWT ───────────────────────────────────────────────────────
SECURITY_JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHARS_BASE64_SECRET
SECURITY_JWT_ISSUER=agri-shrimp

# ── Google OAuth ──────────────────────────────────────────────
APP_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ── Cloudflare Turnstile ──────────────────────────────────────
APP_TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER=agrishrimp/products

# ── PayOS (thanh toán) ────────────────────────────────────────
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME

# ── Email (Gmail SMTP) ────────────────────────────────────────
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD

# ── GHN (vận chuyển) ─────────────────────────────────────────
GHN_API_KEY=CHANGE_ME
GHN_SHOP_ID=CHANGE_ME

# ── TrackAsia (geocoding) ─────────────────────────────────────
TRACKASIA_API_KEY=CHANGE_ME

# ── OpenRouteService (routing) ────────────────────────────────
ORS_API_KEY=CHANGE_ME

# ── Zalo ─────────────────────────────────────────────────────
ZALO_APP_SECRET=CHANGE_ME

# ── AWS S3 (optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=agri-shrimp-storage

# ── AI Service tuning ─────────────────────────────────────────
SIMILARITY_THRESHOLD=0.60
TOP_K_RESULTS=5

# ── Hibernate ─────────────────────────────────────────────────
# Production: dùng "validate" hoặc "none" — KHÔNG dùng "update"
HIBERNATE_DDL_AUTO=validate
