# ============================================================
# AgriShrimp Spring Boot API — Local Environment Template
# Copy this file to `.env` and fill in the real secrets.
#
# Local dev now runs BE + FE directly on your machine and connects
# to the real server DB/Redis through an SSH tunnel:
#   - Recommended: .\start-live-local.ps1 (sets up the tunnel for you)
#   - Manual: ssh -L 3307:127.0.0.1:3306 <user>@<server>
#             keep SPRING_DATASOURCE_URL pointed at localhost:3307
#
# Production values are managed separately on the VPS
# (infra/.env next to infra/docker-compose.prod.yml) — do not
# reuse the values below for production.
# ============================================================

SPRING_PROFILES_ACTIVE=dev,live-local
SERVER_PORT=8004

# Local frontend/backend URLs
APP_SERVER_URL=http://localhost:8004
APP_WEB_BASE_URL=http://localhost:3004
APP_CORS_ALLOWED_ORIGINS=http://localhost:3004,http://localhost:8004
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Required — database (through SSH tunnel)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/agri_shrimp_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Required — Redis (through the same tunnel)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Required — JWT
SECURITY_JWT_SECRET_KEY=replace_with_a_long_random_secret
SECURITY_JWT_ISSUER=agri-shrimp
SECURITY_JWT_EXPIRY_SECONDS=3600
SECURITY_JWT_REFRESHABLE_DURATION_SECONDS=604800

# Required if captcha is enabled
APP_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Required if Google login is enabled
APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Required if Zalo Mini App login is enabled
ZALO_APP_SECRET=your_zalo_app_secret

# Required — Cloudinary/media
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=agrishrimp/products

# Required — payOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:3004/order-success
PAYOS_CANCEL_URL=http://localhost:3004/order-cancel

# Required — shipping/GHN
GHN_API_KEY=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id
SHIPPING_PROVIDER=ghn

# Required — geocoding/routing if branch locator is used
GEOCODING_PROVIDER=trackasia
TRACKASIA_API_KEY=your_trackasia_api_key
TRACKASIA_AUTOCOMPLETE_URL=https://api.trackasia.vn/api/geocode/autocomplete
ROUTING_PROVIDER=ors
ORS_API_KEY=your_openrouteservice_api_key
TRACKASIA_ROUTING_KEY=your_trackasia_routing_key

# Internal AI services — run locally if needed
AI_BASE_URL=http://localhost:8000
IMAGE_SEARCH_URL=http://localhost:5001
AI_PREDICT_PATH=/ai/predict-image

# Optional — CCCD OCR via FPT AI Marketplace VLM
FPT_AI_VLM_BASE_URL=https://mkp-api.fptcloud.com
FPT_AI_VLM_CHAT_COMPLETIONS_PATH=/chat/completions
FPT_AI_VLM_MODEL=Qwen2.5-VL-7B-Instruct
FPT_AI_VLM_API_KEY=your_fpt_ai_marketplace_api_key

# Optional — Gemini, dùng để AI Doctor hỏi làm rõ bệnh khi ảnh có độ tin cậy thấp.
# Không set GEMINI_API_KEY/GEMINI_MODEL thì luồng hỏi-đáp tự chuyển sang review case cho kỹ sư xử lý.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=your_gemini_model_name
GEMINI_API_KEY=your_gemini_api_key
AI_DOCTOR_CLARIFY_MAX_TURNS=8

# Required — mail via Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=thongbao@agrishrimp.io.vn
RESEND_FROM_NAME=AgriShrimp

# Optional — file upload/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=agri-shrimp-storage
AWS_S3_UPLOAD_DIR=webapp

# Optional — Spring Mail (SMTP fallback)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_mail_username
SPRING_MAIL_PASSWORD=your_mail_password

# Optional — app tuning
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB
LOCATION_DEFAULT_RADIUS_KM=15
LOCATION_MAX_CANDIDATES=5
LOCATION_IP_GEO_URL=http://ip-api.com/json

# Optional — remote OCR proxy
OCR_REMOTE_ENABLED=false
OCR_REMOTE_BASE_URL=http://localhost:5001
OCR_REMOTE_PATH=/ocr/cccd

# Optional — OCR/Tesseract
OCR_TESSERACT_LANGUAGE=vie
OCR_TESSERACT_DATA_PATH=/usr/share/tesseract-ocr/5/tessdata
OCR_MAX_FILE_SIZE_BYTES=5242880
OCR_MAX_IMAGE_WIDTH=1800
